# Copia este archivo como .env y completa los valores.
#   PowerShell:  Copy-Item .env.example .env
# El archivo .env NO se sube a ningún repositorio (está en .gitignore).

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True en desarrollo; False en un despliegue real
DEBUG=True
# Dominios permitidos, separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo para despliegues con HTTPS, por ejemplo https://fiafacil.onrender.com
CSRF_TRUSTED_ORIGINS=

# Base de datos PostgreSQL (probado con la versión 16)
DB_NAME=fiafacil
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Canales de soporte: número de WhatsApp con código de país, sin "+" ni espacios
SOPORTE_WHATSAPP=51999999999
SOPORTE_CORREO=soporte@fiafacil.pe
